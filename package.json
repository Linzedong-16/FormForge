{
  "name": "formforge",
  "version": "1.0.0",
  "description": "开源低代码问卷/表单构建平台 — FormForge",
  "license": "MIT",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint:prettier": "prettier --write --end-of-line lf \"**/*.{js,ts,mjs,cjs,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:eslint": "eslint --cache",
    "lint": "lint-staged --diff=HEAD",
    "lint:all": "pnpm lint:prettier && pnpm lint:eslint --fix",
    "lint:spellcheck": "cspell lint \"(packages|app)/**/*.{js,ts,mjs,cjs,json,css,less,scss,vue,html,md}\"",
    "commit": "pnpm exec git-cz",
    "prepare": "husky",
    "precommit": "lint-staged",
    "start": "concurrently \"pnpm --filter ./app/backend dev\" \"pnpm --filter ./app/frontend dev\"",
    "dev:main": "pnpm --filter ./app/main-app dev",
    "dev:editor": "pnpm --filter ./app/q-editor dev",
    "dev:admin": "pnpm --filter ./app/frontend dev",
    "dev:micro": "concurrently \"pnpm dev:main\" \"pnpm dev:editor\" \"pnpm dev:admin\"",
    "dev:mock": "pnpm --filter ./app/q-editor dev --mode mock",
    "dev:ai": "cd app/ai-service && conda run -n form-agent python -m uvicorn src.main:app --host 0.0.0.0 --port 8090 --reload",
    "dev:components": "pnpm --filter monorepo-code-components dev",
    "typecheck:components": "pnpm --filter monorepo-code-components typecheck"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "keywords": [
    "monorepo",
    "demo"
  ],
  "author": "linzex",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.17.0",
    "pnpm": ">=10.12.4",
    "npm": ">=10.9.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@cspell/dict-lorem-ipsum": "^4.0.5",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.1",
    "cspell": "^9.3.2",
    "cz-git": "^1.12.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
