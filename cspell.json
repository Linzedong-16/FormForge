{
  "import": ["@cspell/dict-lorem-ipsum/cspell-ext.json"],
  "caseSensitive": false,
  "dictionaries": ["custom-dictionary"],
  "ignoreRegExpList": [
    // "\"[\\w\\s\\-\\:\\/\\.\\,\\;\\'\\!\\?\\[\\]]*\"",
    "<[a-zA-Z0-9]+-[^>]*>",
    "<\/[a-zA-Z0-9]+-[^>]*>"
  ],
  "dictionaryDefinitions": [
    {
      "name": "custom-dictionary",
      "path": "./.cspell/custom-dictionary.txt",
      "addWords": true
    }
  ],

  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/lib/**",
    "**/docs/**",
    "**/vendor/**",
    "**/public/**",
    "**/static/**",
    "**/out/**",
    "**/tmp/**",
    "**/*.d.ts",
    "**/package.json",
    "**/*.md",
    "**/stats.html",
    "eslint.config.mjs",
    ".gitignore",
    ".prettierignore",
    "cspell.json",
    "commitlint.config.js",
    ".cspell",
    "docs/**/*.md",
    ".vscode/extensions.json",
    ".vscode/settings.json",
    ".lintstagedrc.js"
  ]
}
