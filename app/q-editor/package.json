{
  "name": "q-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:standalone": "run-p type-check \"build-only {@}\" -- --mode standalone",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "npx playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:report": "npx playwright show-report e2e/playwright-report",
    "test:all": "pnpm test && pnpm test:e2e",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/vue-fontawesome": "^3.1.3",
    "@intlify/unplugin-vue-i18n": "^11.2.3",
    "axios": "^1.13.2",
    "dexie": "^4.4.2",
    "element-plus": "^2.13.2",
    "mitt": "^3.0.1",
    "monorepo-code-common": "workspace:*",
    "monorepo-code-components": "workspace:*",
    "monorepo-sse-client": "workspace:*",
    "monorepo-tracking-sdk": "workspace:*",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode": "^1.5.4",
    "uuid": "^13.0.0",
    "vue": "^3.5.25",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.6.3",
    "vuedraggable": "4.0.0",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.1",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-legacy": "7.2.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitejs/plugin-vue-jsx": "^5.1.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "~10.5.1",
    "happy-dom": "^20.10.6",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.97.3",
    "typescript": "~5.9.0",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.2.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-inspect": "^11.3.3",
    "vite-plugin-istanbul": "9.0.1",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-qiankun": "^1.0.14",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.1.5"
  }
}
