// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 1. 用户表 (users)
// ============================================================
model User {
  id            BigInt    @id @default(autoincrement())
  email         String    @unique
  password_hash String
  username      String
  role          String    @default("user") // admin / user
  avatar_url    String?
  status        Int       @default(1) // 0:禁用 1:启用
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  last_login_at      DateTime?
  password_updated_at DateTime? // NULL = 从未改密，首次登录强制修改
  deleted_at         DateTime? // 软删除标记
  deleted_by         BigInt?   // 删除操作人 ID

  // 关联关系
  surveys           Survey[]
  templates         Template[]
  responses         Response[]
  tokens            ApiToken[]
  audit_logs        AuditLog[]         @relation("AuditLogUser")
  permissions       SurveyPermission[]
  user_roles        UserRole[]
  submitted_reviews Review[]           @relation("ReviewSubmitter") // 自己提交的审核
  reviewed_reviews  Review[]           @relation("ReviewReviewer") // 自己审核的记录
  template_ratings  TemplateRating[] // 自己对模板的评分
  profile           UserProfile? // 用户资料（1:1）
  survey_files      SurveyFile[] // 上传的问卷文件
  sent_messages     Message[]               @relation("MessageSender") // 自己发出的消息
  received_messages Message[]               @relation("MessageRecipient") // 自己收到的消息
  message_broadcast_states MessageBroadcastState[] // 自己对各条广播的已读/隐藏状态

  @@index([email])
  @@index([status])
  @@index([deleted_at])
  @@index([deleted_by])
  @@map("users")
}

// ============================================================
// 2. 问卷表 (surveys)
// ============================================================
model Survey {
  id              BigInt    @id @default(autoincrement())
  user_id         BigInt
  title           String
  description     String?
  status          Int       @default(0) // 0:草稿 1:发布 2:关闭
  page_size       Int       @default(10)
  total_questions Int       @default(0)
  responses_count Int       @default(0) // 答卷数缓存
  is_public       Int       @default(0) // 0:私有 1:公开
  access_code     String? // 访问密码
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  published_at    DateTime?
  closed_at       DateTime?
  deleted_at      DateTime? // 软删除标记

  deadline                  DateTime? // 问卷截止时间（此前只存在于 Redis TTL，供消息系统的
                                       // "即将过期提醒"定时扫描使用，见消息系统 data-model.md §4）
  expiring_reminder_sent_at DateTime? // "即将过期"提醒已发送时间，避免重复提醒
  last_milestone_notified   Int       @default(0) // 已通知过的最高答卷里程碑阈值（0/50/100/500）

  review_status  ReviewStatus @default(none) // 审核状态：none / pending / approved / rejected

  // 关联关系
  user             User               @relation(fields: [user_id], references: [id])
  components       SurveyComponent[]
  responses        Response[]
  permissions      SurveyPermission[]
  reviews          Review[] // 审核记录
  files            SurveyFile[] // 关联的问卷文件

  @@index([status])
  @@index([created_at])
  @@index([is_public])
  @@index([deleted_at])
  @@index([user_id, deleted_at, updated_at]) // 高频：列表查询 WHERE user_id=? AND deleted_at IS NULL ORDER BY updated_at DESC
  @@index([deleted_at, review_status, created_at]) // 未审核问卷查询：WHERE deleted_at IS NULL AND review_status='none' ORDER BY created_at DESC
  @@map("surveys")
}

// ============================================================
// 3. 问卷组件表 (survey_components)
// ============================================================
model SurveyComponent {
  id          BigInt   @id @default(autoincrement())
  survey_id   BigInt
  type        String // 组件类型（如 single_choice, multi_choice, text_input 等）
  config      Json // 组件配置 JSON
  order_index Int      @default(0) // 排序索引
  required    Int      @default(0) // 0:非必填 1:必填
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // 关联关系
  survey  Survey   @relation(fields: [survey_id], references: [id])
  answers Answer[]

  @@index([survey_id])
  @@index([survey_id, order_index])
  @@map("survey_components")
}

// ============================================================
// 4. 模板表 (templates) — 方案B：完全解耦，独立于 Survey 表
// ============================================================
model Template {
  id               BigInt        @id @default(autoincrement())
  user_id          BigInt
  title            String
  description      String?
  category         String? // 模板分类：education / market / hr / customer / event / other
  cover_url        String? // 模板封面图 URL（MinIO 对象存储）
  download_count   Int           @default(0) // 模板使用次数（用于热门排序）
  rating           Decimal?      @default(0) @db.Decimal(2, 1) // 模板平均评分 0.0 ~ 5.0
  review_status    ReviewStatus  @default(approved) // 审核状态：模板上架后默认为 approved
  source_survey_id BigInt? // 来源问卷 ID（通过审核的问卷，用于追溯）
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  // 关联关系
  user       User                @relation(fields: [user_id], references: [id])
  components TemplateComponent[]
  ratings    TemplateRating[]
  reviews    Review[]

  @@index([user_id])
  @@index([category])
  @@index([review_status])
  @@index([category, review_status]) // 模板市场查询：WHERE category=? AND review_status='approved'
  @@index([download_count]) // 按热门排序
  @@index([rating]) // 按评分排序
  @@map("templates")
}

// ============================================================
// 5. 模板组件表 (template_components)
// ============================================================
model TemplateComponent {
  id          BigInt   @id @default(autoincrement())
  template_id BigInt
  type        String // 组件类型
  config      Json     @default("{}") // 组件配置 JSON
  order_index Int      @default(0) // 排序索引
  required    Int      @default(0) // 0:非必填 1:必填
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // 关联关系
  template Template @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@index([template_id])
  @@index([template_id, order_index])
  @@map("template_components")
}

// ============================================================
// 6. 答卷表 (responses)
// ============================================================
model Response {
  id           BigInt    @id @default(autoincrement())
  survey_id    BigInt
  user_id      BigInt? // 登录用户 ID
  anonymous_id String? // 匿名用户标识
  status       Int       @default(0) // 0:未完成 1:已提交
  submitted_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  // 关联关系
  survey  Survey   @relation(fields: [survey_id], references: [id])
  user    User?    @relation(fields: [user_id], references: [id])
  answers Answer[]

  @@index([survey_id])
  @@index([user_id])
  @@index([submitted_at])
  @@map("responses")
}

// ============================================================
// 5. 答案表 (answers)
// ============================================================
model Answer {
  id           BigInt   @id @default(autoincrement())
  response_id  BigInt
  component_id BigInt
  value        String? // 单值答案（文本/单选）
  values       Json? // 多选答案数组
  created_at   DateTime @default(now())

  // 关联关系
  response  Response        @relation(fields: [response_id], references: [id])
  component SurveyComponent @relation(fields: [component_id], references: [id])

  @@index([response_id])
  @@index([component_id])
  @@map("answers")
}

// ============================================================
// 6. API 令牌表 (api_tokens)
// ============================================================
model ApiToken {
  id           BigInt    @id @default(autoincrement())
  user_id      BigInt
  token        String    @unique
  name         String // 令牌名称
  scope        String? // 权限范围 JSON
  expires_at   DateTime? // 过期时间
  status       Int       @default(1) // 0:禁用 1:启用
  created_at   DateTime  @default(now())
  last_used_at DateTime? // 最后使用时间

  // 关联关系
  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([token])
  @@index([status])
  @@map("api_tokens")
}

// ============================================================
// 7. 审计日志表 (audit_logs)
// ============================================================
model AuditLog {
  id            BigInt   @id @default(autoincrement())
  user_id       BigInt?
  action        String // 操作类型
  resource_type String // 资源类型
  resource_id   BigInt? // 资源 ID
  details       Json? // 操作详情 JSON
  ip_address    String? // 客户端 IP
  user_agent    String? // 浏览器信息
  created_at    DateTime @default(now())

  // 关联关系（单向，不强制反向关系）
  user User? @relation(name: "AuditLogUser", fields: [user_id], references: [id])

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@index([resource_type, resource_id])
  @@map("audit_logs")
}

// ============================================================
// 8. 系统配置表 (system_configs)
// ============================================================
model SystemConfig {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique
  value       String?
  description String?
  category    String   @default("general") // 配置分类
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([key])
  @@index([category])
  @@map("system_configs")
}

// ============================================================
// 9. 问卷权限表 (survey_permissions) — 多对多关系
// ============================================================
model SurveyPermission {
  survey_id  BigInt
  user_id    BigInt
  permission String // view / edit / delete

  // 关联关系
  survey Survey @relation(fields: [survey_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([survey_id, user_id])
  @@index([survey_id])
  @@index([user_id])
  @@map("survey_permissions")
}

// ============================================================
// 10. 用户角色关联表 (user_roles) — 多对多关系
// ============================================================
model UserRole {
  user_id   BigInt
  role_code RoleCode

  // 关联关系
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_code])
  @@index([user_id])
  @@index([role_code])
  @@map("user_roles")
}

enum RoleCode {
  super_admin // 超级管理员
  user // 普通用户
}

// ============================================================
// 枚举：审核状态
// ============================================================
enum ReviewStatus {
  none // 未申请审核（个人问卷默认状态）
  pending // 审核中
  approved // 已通过（问卷审核通过后可发布；模板审核通过后上架模板市场）
  rejected // 已驳回（违规/需修改）
}

// ============================================================
// 枚举：审核类型
// ============================================================
enum ReviewType {
  survey // 问卷审核（所有个人问卷发布前必须通过）
  template // 模板审核（申请成为公共模板，需先通过问卷审核）
}

// ============================================================
// 枚举：问卷文件类型
// ============================================================
enum FileType {
  survey_option_image // 图片选择组件封面图（PicItem 上传）
  survey_signature // 签名图片（Signature canvas 转 blob 后上传）
  survey_cover // 问卷封面图（survey.cover_url，预留）
}

// ============================================================
// 11. 审核记录表 (reviews)
// ============================================================
model Review {
  id             BigInt       @id @default(autoincrement())
  survey_id      BigInt? // 问卷 ID（问卷审核时必填，模板审核时可为 null）
  template_id    BigInt? // 模板 ID（模板审核通过后回填，问卷审核时为 null）
  submitter_id   BigInt // 提交者（问卷作者）
  reviewer_id    BigInt? // 审核人（管理员），审核前为 null
  review_type    ReviewType   @default(survey) // 审核类型：survey=问卷审核 / template=模板审核
  status         ReviewStatus @default(pending) // pending / approved / rejected
  category       String? // 模板分类（模板审核时由 applyTemplate 传入，问卷审核时为 null）
  submit_message String?      @db.Text // 提交时附加说明，最大 500 字符
  review_comment String?      @db.Text // 审核意见（通过/驳回时填写）
  submitted_at   DateTime     @default(now()) // 提交时间
  reviewed_at    DateTime? // 审核完成时间
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  // 关联关系
  survey    Survey?   @relation(fields: [survey_id], references: [id], onDelete: Cascade)
  template  Template? @relation(fields: [template_id], references: [id], onDelete: Cascade)
  submitter User      @relation("ReviewSubmitter", fields: [submitter_id], references: [id])
  reviewer  User?     @relation("ReviewReviewer", fields: [reviewer_id], references: [id])

  @@index([survey_id])
  @@index([template_id])
  @@index([submitter_id])
  @@index([reviewer_id])
  @@index([review_type])
  @@index([status])
  @@index([submitted_at])
  @@index([review_type, status, submitted_at]) // 高频：审核列表 WHERE review_type=? AND status=? ORDER BY submitted_at DESC
  @@index([survey_id, status]) // 高频：检查同一问卷是否已有审核中记录
  @@index([template_id, status]) // 高频：检查同一模板是否已有审核中记录
  @@map("reviews")
}

// ============================================================
// 12. 模板评分表 (template_ratings)
// ============================================================
model TemplateRating {
  id          BigInt   @id @default(autoincrement())
  template_id BigInt // 模板 ID
  user_id     BigInt // 评分用户
  score       Int // 评分 1-5
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // 关联关系
  template Template @relation(fields: [template_id], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([template_id, user_id]) // 同一用户对同一模板仅一条评分记录
  @@index([template_id])
  @@index([template_id, score])
  @@map("template_ratings")
}

// ============================================================
// 13. 用户资料表 (user_profiles) — 1:1 关联 User
//
// 设计说明：
//   - User 表存放认证核心字段（email / password_hash / username）
//   - UserProfile 存放可编辑的展示资料，与 User 一一对应
//   - 头像字段优先使用本表 avatar_url；User.avatar_url 保留作为兜底/缓存
//   - bound_email 与 User.email 解耦，支持换绑流程
// ============================================================
model UserProfile {
  id             BigInt    @id @default(autoincrement())
  user_id        BigInt    @unique // 与 User 一一对应
  nickname       String?   @db.VarChar(50) // 用户昵称，最大 50 字符
  avatar_url     String?   @db.VarChar(500) // 头像 URL（MinIO / 裁剪后上传）
  occupation     String?   @db.VarChar(100) // 职业，最大 100 字符
  bio            String?   @db.VarChar(500) // 个人介绍，最大 500 字符（与前端 maxlength 一致）
  interests      Json?     @default("[]") // 兴趣标签 JSON 数组，如 ["前端","设计"]
  bound_email    String?   @db.VarChar(255) // 绑定邮箱（与 User.email 解耦，支持换绑）
  email_verified Boolean   @default(false) // 绑定邮箱是否已验证
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // 关联关系
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_profiles")
}

// ============================================================
// 14. 问卷文件表 (survey_files)
//
// 设计目的：
//   - 追踪问卷编辑器上传的所有文件（图片选择组件封面、签名图片）
//   - 支撑问卷删除时级联清理 MinIO 文件
//   - 提供文件溯源（上传者、上传时间、文件大小）
//   - 识别孤儿文件（已从 survey_components.config 中移除但 MinIO 仍有残留）
// ============================================================
model SurveyFile {
  id         BigInt   @id @default(autoincrement())
  survey_id  BigInt?  // 所属问卷（可为 null，签名文件关联 response 而非 survey）
  user_id    BigInt   // 上传者
  file_url   String   @db.VarChar(1024) // MinIO 完整访问 URL
  file_key   String   @db.VarChar(512)  // MinIO 对象 key（如 "survey-images/uuid.png"），删除时需要
  file_name  String   @db.VarChar(255)  // 原始文件名
  mime_type  String   @db.VarChar(127)  // MIME 类型（如 "image/png"）
  file_size  BigInt   // 文件大小（字节）
  file_type  FileType @default(survey_option_image) // 文件来源类型
  created_at DateTime @default(now())

  // 关联关系
  survey Survey? @relation(fields: [survey_id], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([survey_id])
  @@index([user_id])
  @@index([file_type])
  @@index([created_at])
  @@index([survey_id, file_type]) // 高频：按问卷查询特定类型文件
  @@map("survey_files")
}

// ============================================================
// 15. 消息表 (messages)
//
// 设计目的：
//   - 承载 5 类消息（操作通知/模板互动/问卷生命周期/用户-管理员通信/管理员广播）
//   - is_read/read_at/deleted_at 三个独立字段分别表达已读与（软）删除两个维度，
//     互不冲突（详见消息系统 research.md §12）
//   - 广播消息 recipient_id = NULL，配合 target_role 限定可见范围；
//     广播的已读/隐藏状态不写在本表，见 MessageBroadcastState（§16）
// ============================================================
enum MessageType {
  operation_notify // 操作通知（审核结果、用户封禁/解封）
  template_like // 模板互动（评分、被应用于创建问卷）
  survey_lifecycle // 问卷生命周期（发布成功、即将过期、答卷里程碑）
  user_admin_comm // 用户-管理员通信
  admin_broadcast // 管理员广播
}

model Message {
  id                  BigInt      @id @default(autoincrement())
  type                MessageType
  title               String      @db.VarChar(200)
  content             String      @db.Text
  sender_id           BigInt? // 发送者；null = 系统自动发出
  recipient_id        BigInt? // 接收者；null = 面向群体的广播（配合 target_role）
  target_role         String?     @db.VarChar(20) // 仅广播使用："all" / "user" / "super_admin"
  related_resource    String?     @db.VarChar(50) // "survey" / "template" / "review"
  related_resource_id BigInt?

  is_read    Boolean   @default(false)
  read_at    DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime? // 软删除时间（仅影响接收者自己的可见性）

  // 关联关系
  sender          User?                   @relation("MessageSender", fields: [sender_id], references: [id])
  recipient       User?                   @relation("MessageRecipient", fields: [recipient_id], references: [id])
  broadcastStates MessageBroadcastState[]

  @@index([recipient_id, is_read, created_at]) // 用户收件箱（核心查询）
  @@index([type, created_at]) // 按类型统计
  @@index([sender_id, created_at]) // 管理员查看已发送
  @@index([deleted_at]) // 清理任务扫描
  @@index([created_at]) // 时间范围查询
  @@map("messages")
}

// ============================================================
// 16. 广播已读/隐藏状态表 (message_broadcast_states)
//
// 设计目的：
//   - 广播消息只有一条 recipient_id=NULL 的物理记录，无法直接在共享记录上记
//     "用户 A 已读"；本表按"用户 × 广播消息"维度惰性记录每个用户的已读/隐藏状态
//   - 只有当用户真正读/删过某条广播时才会写一行，不会在广播发出时批量写入
//     （消息系统 research.md §13，修复"状态只存在 Redis"的架构问题）
// ============================================================
model MessageBroadcastState {
  id         BigInt    @id @default(autoincrement())
  message_id BigInt
  user_id    BigInt
  is_read    Boolean   @default(false)
  read_at    DateTime?
  is_hidden  Boolean   @default(false)
  hidden_at  DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([message_id, user_id])
  @@index([user_id, is_hidden])
  @@map("message_broadcast_states")
}
