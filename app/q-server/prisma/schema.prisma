// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ============================================================
// 1. 用户表 (users)
// ============================================================
model User {
  id            BigInt    @id @default(autoincrement())
  email         String    @unique
  password_hash String
  username      String
  role          String    @default("user") // admin / user
  avatar_url    String?
  status        Int       @default(1) // 0:禁用 1:启用
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  last_login_at DateTime?
  deleted_at    DateTime? // 软删除标记

  // 关联关系
  surveys           Survey[]
  responses         Response[]
  tokens            ApiToken[]
  audit_logs        AuditLog[]
  permissions       SurveyPermission[]
  user_roles        UserRole[]

  @@index([email])
  @@index([status])
  @@index([deleted_at])
  @@map("users")
}

// ============================================================
// 2. 问卷表 (surveys)
// ============================================================
model Survey {
  id              BigInt    @id @default(autoincrement())
  user_id         BigInt
  title           String
  description     String?
  status          Int       @default(0) // 0:草稿 1:发布 2:关闭
  page_size       Int       @default(10)
  total_questions Int       @default(0)
  responses_count Int       @default(0) // 答卷数缓存
  is_public       Int       @default(0) // 0:私有 1:公开
  access_code     String?               // 访问密码
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  published_at    DateTime?
  closed_at       DateTime?

  // 关联关系
  user             User               @relation(fields: [user_id], references: [id])
  components       SurveyComponent[]
  responses        Response[]
  audit_logs       AuditLog[]
  permissions      SurveyPermission[]

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@index([is_public])
  @@map("surveys")
}

// ============================================================
// 3. 问卷组件表 (survey_components)
// ============================================================
model SurveyComponent {
  id          BigInt   @id @default(autoincrement())
  survey_id   BigInt
  type        String                // 组件类型（如 single_choice, multi_choice, text_input 等）
  config      Json                  // 组件配置 JSON
  order_index Int      @default(0)  // 排序索引
  required    Int      @default(0)  // 0:非必填 1:必填
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // 关联关系
  survey      Survey   @relation(fields: [survey_id], references: [id])
  answers     Answer[]

  @@index([survey_id])
  @@index([survey_id, order_index])
  @@map("survey_components")
}

// ============================================================
// 4. 答卷表 (responses)
// ============================================================
model Response {
  id           BigInt    @id @default(autoincrement())
  survey_id    BigInt
  user_id      BigInt?               // 登录用户 ID
  anonymous_id String?               // 匿名用户标识
  status       Int       @default(0) // 0:未完成 1:已提交
  submitted_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  // 关联关系
  survey       Survey    @relation(fields: [survey_id], references: [id])
  user         User?     @relation(fields: [user_id], references: [id])
  answers      Answer[]

  @@index([survey_id])
  @@index([user_id])
  @@index([submitted_at])
  @@map("responses")
}

// ============================================================
// 5. 答案表 (answers)
// ============================================================
model Answer {
  id           BigInt           @id @default(autoincrement())
  response_id  BigInt
  component_id BigInt
  value        String?          // 单值答案（文本/单选）
  values       Json?            // 多选答案数组
  created_at   DateTime         @default(now())

  // 关联关系
  response     Response         @relation(fields: [response_id], references: [id])
  component    SurveyComponent  @relation(fields: [component_id], references: [id])

  @@index([response_id])
  @@index([component_id])
  @@map("answers")
}

// ============================================================
// 6. API 令牌表 (api_tokens)
// ============================================================
model ApiToken {
  id           BigInt    @id @default(autoincrement())
  user_id      BigInt
  token        String    @unique
  name         String                // 令牌名称
  scope        String?               // 权限范围 JSON
  expires_at   DateTime?             // 过期时间
  status       Int       @default(1) // 0:禁用 1:启用
  created_at   DateTime  @default(now())
  last_used_at DateTime?             // 最后使用时间

  // 关联关系
  user         User      @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([token])
  @@index([status])
  @@map("api_tokens")
}

// ============================================================
// 7. 审计日志表 (audit_logs)
// ============================================================
model AuditLog {
  id            BigInt    @id @default(autoincrement())
  user_id       BigInt?
  action        String                // 操作类型
  resource_type String                // 资源类型
  resource_id   BigInt?               // 资源 ID
  details       Json?                 // 操作详情 JSON
  ip_address    String?               // 客户端 IP
  user_agent    String?               // 浏览器信息
  created_at    DateTime  @default(now())

  // 关联关系
  user          User?     @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@index([resource_type, resource_id])
  @@map("audit_logs")
  surveys Survey[]
}

// ============================================================
// 8. 系统配置表 (system_configs)
// ============================================================
model SystemConfig {
  id          BigInt    @id @default(autoincrement())
  key         String    @unique
  value       String?
  description String?
  category    String    @default("general") // 配置分类
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@index([key])
  @@index([category])
  @@map("system_configs")
}

// ============================================================
// 9. 问卷权限表 (survey_permissions) — 多对多关系
// ============================================================
model SurveyPermission {
  survey_id  BigInt
  user_id    BigInt
  permission String // view / edit / delete

  // 关联关系
  survey     Survey  @relation(fields: [survey_id], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([survey_id, user_id])
  @@index([survey_id])
  @@index([user_id])
  @@map("survey_permissions")
}

// ============================================================
// 10. 用户角色关联表 (user_roles) — 多对多关系
// ============================================================
model UserRole {
  user_id   BigInt
  role_code RoleCode

  // 关联关系
  user      User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_code])
  @@index([user_id])
  @@index([role_code])
  @@map("user_roles")
}

enum RoleCode {
  super_admin  // 超级管理员
  user         // 普通用户
}